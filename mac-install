#!/bin/bash
#
# install-mac.sh — installs to the user's home folder, no sudo, no admin prompts
#
#   curl -fsSL https://xxx.com/install-mac.sh | bash
#

APP_NAME="yourapp"
DOWNLOAD_URL="https://xxx.com/download/mac"
INSTALL_DIR="$HOME/.yourapp/bin"
INSTALL_PATH="$INSTALL_DIR/$APP_NAME"

mkdir -p "$INSTALL_DIR"


curl -fsSL "$DOWNLOAD_URL" -o "$INSTALL_PATH"
chmod +x "$INSTALL_PATH"
xattr -d com.apple.quarantine "$INSTALL_PATH" 2>/dev/null

SHELL_RC="$HOME/.zshrc"
[ -f "$HOME/.bash_profile" ] && [ -n "$BASH_VERSION" ] && SHELL_RC="$HOME/.bash_profile"
grep -q "$INSTALL_DIR" "$SHELL_RC" 2>/dev/null || echo "export PATH=\"$INSTALL_DIR:\$PATH\"" >> "$SHELL_RC"
export PATH="$INSTALL_DIR:$PATH"

