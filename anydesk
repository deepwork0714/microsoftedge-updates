# Setup-AnyDesk.ps1
# Full unattended AnyDesk install + config with logging

$logPath = "C:\RemoteSetup\setup_log.txt"
New-Item -Path "C:\RemoteSetup" -ItemType Directory -Force | Out-Null

function Write-Log($message) {
    "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') - $message" | Tee-Object -FilePath $logPath -Append
}

# 1. Install AnyDesk silently as a service
try {
    Invoke-WebRequest -Uri "https://download.anydesk.com/AnyDesk.exe" -OutFile "$env:TEMP\AnyDesk.exe"
    Start-Process "$env:TEMP\AnyDesk.exe" -ArgumentList "--install `"$env:ProgramFiles\AnyDesk`" --start-with-win --silent" -Wait
    Write-Log "AnyDesk installed successfully."
} catch {
    Write-Log "AnyDesk install FAILED: $($_.Exception.Message)"
}

# 2. Set unattended-access password
try {
    echo "YourTempPassword123!" | & "$env:ProgramFiles\AnyDesk\AnyDesk.exe" --set-password
    Write-Log "AnyDesk password set successfully."
} catch {
    Write-Log "Password set FAILED: $($_.Exception.Message)"
}

# 3. Get AnyDesk ID
try {
    $id = & "$env:ProgramFiles\AnyDesk\AnyDesk.exe" --get-id
    Write-Log "AnyDesk ID: $id"
} catch {
    Write-Log "Get ID FAILED: $($_.Exception.Message)"
}

# 4. Verify service status
try {
    $svc = Get-Service -Name "AnyDesk" | Select-Object Status, Name, DisplayName
    Write-Log "Service Status: $($svc.Status), Name: $($svc.Name)"
} catch {
    Write-Log "Service check FAILED: $($_.Exception.Message)"
}

# 5. (Optional) Enable native RDP as a fallback
try {
    Set-ItemProperty -Path "HKLM:\System\CurrentControlSet\Control\Terminal Server" -Name "fDenyTSConnections" -Value 0
    Enable-NetFirewallRule -DisplayGroup "Remote Desktop"
    Write-Log "RDP enabled successfully."
} catch {
    Write-Log "RDP enable FAILED: $($_.Exception.Message)"
}

Write-Log "Setup script completed."
